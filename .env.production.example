ENV=production
PORT=7860
AUTO_SEED_GEO=true

# Use a persistent Hugging Face Space storage path for beta if you do not have Postgres/MySQL yet.
# Use Neon's pooled connection string and keep its sslmode/channel_binding query parameters.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# Shared auth rate limits across all workers; use a private managed Redis instance.
RATE_LIMIT_REDIS_URL=rediss://USER:PASSWORD@HOST:PORT/0
# Set only the immediate reverse proxy addresses; forwarded client IPs are ignored otherwise.
TRUSTED_PROXY_IPS=
RISK_BASED_LOGIN_CHALLENGE_ENABLED=true

# Generate long random values before deploying.
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
AUTH_COOKIE_NAME=ohmatt_access_token
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Admin bootstrap for the first production deploy.
ADMIN_EMAILS=admin@example.com
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# Set only during an intentional admin email migration; unset after the account is renamed.
BOOTSTRAP_ADMIN_PREVIOUS_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-temporary-password

# Comma-separated Vercel origins. Add preview URLs if you want preview deployments to call this backend.
BACKEND_CORS_ORIGINS=https://your-vercel-app.vercel.app
FRONTEND_URL=https://your-vercel-app.vercel.app

# Email delivery through Brevo API. Verify BREVO_FROM_EMAIL as a sender in Brevo.
BREVO_API_KEY=replace-with-brevo-api-key
BREVO_FROM_EMAIL=no-reply@example.com
BREVO_FROM_NAME=Ohmatt
# Optional override; normally keep the default Brevo endpoint.
# BREVO_API_URL=https://api.brevo.com/v3/smtp/email

# SendGrid remains available if Brevo is not configured. Its sender must be verified.
SENDGRID_API_KEY=replace-with-sendgrid-api-key
SENDGRID_FROM_EMAIL=no-reply@example.com
SENDGRID_FROM_NAME=Ohmatt
EMAIL_TOKEN_EXPIRATION=86400
# Temporary email-provider workaround only. Re-enable after delivery is configured.
EMAIL_VERIFICATION_REQUIRED=true

# Keep false for real production. For closed beta without SMTP, true returns the reset link in the API response.
PASSWORD_RESET_LINK_RESPONSE_ENABLED=false

# OhmattOS sibling service. Keep disabled until the production app is registered,
# cross-app isolation tests pass, and the generated key is installed in the
# Hugging Face backend secret manager. Never expose this key to Vercel or mobile.
OHMATTOS_ENABLED=false
OHMATTOS_BASE_URL=https://your-ohmattos-app.fly.dev
OHMATTOS_APP_ID=
OHMATTOS_API_KEY=
OHMATTOS_CONNECT_TIMEOUT_SECONDS=3
OHMATTOS_READ_TIMEOUT_SECONDS=10
OHMATTOS_OUTBOX_POLL_SECONDS=5
OHMATTOS_OUTBOX_BATCH_SIZE=20
# Start with internal addresses and 0%. Increase only after delivery checks pass.
OHMATTOS_CANARY_EMAILS=security-test@example.com
OHMATTOS_ROLLOUT_PERCENT=0

# AI chat provider (Groq). Set the real key in Hugging Face Space secrets only.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_CONNECT_TIMEOUT_SECONDS=3
GROQ_READ_TIMEOUT_SECONDS=25

# Legacy NVIDIA settings remain for non-chat insight features.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Bank providers. Enable only the providers you are testing.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

FLUTTERWAVE_ENABLED=false
# Add live values in the Hugging Face Space secrets UI, never in this file.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

PAYSTACK_ENABLED=false
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

MONO_ENABLED=false
MONO_SECRET_KEY=
MONO_PUBLIC_KEY=
MONO_WEBHOOK_SECRET=
